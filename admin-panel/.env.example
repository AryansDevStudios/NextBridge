# NextBridge Admin Panel — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.

# Admin username
VITE_ADMIN_USERNAME=admin

# SHA-256 hash of the admin password (NOT the plaintext password)
# Generate: node -e "const c=require('crypto'); console.log(c.createHash('sha256').update('YOUR_PASSWORD').digest('hex'));"
VITE_ADMIN_PASSWORD_HASH=<sha256_hash_of_password_here>
